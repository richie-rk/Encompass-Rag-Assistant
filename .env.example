# =============================================================================
# Encompass RAG Assistant — environment template
# Copy this file to `.env` and fill in values. `.env` is gitignored.
# =============================================================================

# --- LLM provider --------------------------------------------------------------
# false -> Ollama (local), true -> Google Gemini (cloud)
USE_GEMINI=false

# Ollama model (used when USE_GEMINI=false). Pull with: ollama pull qwen2.5-coder:7b
OLLAMA_MODEL=qwen2.5-coder:7b

# Google Gemini key (used when USE_GEMINI=true). Get one at https://ai.google.dev/
GEMINI_API_KEY=

# LLM sampling temperature
TEMPERATURE=0.1

# --- Vector store --------------------------------------------------------------
# Directory containing the FAISS index, BM25 pickles, and metadata pickles
VECTOR_STORE_PATH=vector_store

# --- Embeddings (Jina v3) -----------------------------------------------------
# `local`  -> sentence-transformers loads jina-embeddings-v3 from HuggingFace
# `api`    -> calls Jina's HTTPS endpoint (needs JINA_API_KEY)
JINA_BACKEND=local
JINA_API_KEY=
JINA_MODEL=jinaai/jina-embeddings-v3
# `cpu`, `cuda`, or `mps`. `cpu` works but ingest is slow (~570M-param model).
JINA_DEVICE=cpu

# --- API server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(levelname)s - [%(filename)s:%(lineno)d] - %(message)s
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# --- Retrieval ----------------------------------------------------------------
# Documented in README but currently hardcoded in CustomRetriever — see CLAUDE.md
HYBRID_ALPHA=0.6
RETRIEVAL_K=5
